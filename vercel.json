{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/notify.js": { "maxDuration": 60, "memory": 1024 },
    "api/users.js": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "microphone=(self)" }] }
  ]
}
