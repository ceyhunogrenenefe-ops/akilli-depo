# ---------- Ön yüz (tarayıcı) ----------
# Boş bırakılırsa uygulama DEMO modunda çalışır (veriler yalnızca tarayıcıda)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Sunucu (Vercel ortam değişkenleri) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # GİZLİ — yalnızca Vercel'de

# ---------- E-posta (birini seçin) ----------
EMAIL_FROM=Akıllı Depo <depo@alanadiniz.com>
# A) Resend
RESEND_API_KEY=
# B) SMTP (ör. Gmail: smtp.gmail.com, 465, uygulama şifresi)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------- WhatsApp ----------
# meta | twilio | webhook
WHATSAPP_PROVIDER=
# meta (WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=             # onaylı şablon adı (başlık: Doküman, gövde: {{1}})
WHATSAPP_TEMPLATE_LANG=tr
# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# webhook (kendi whatsapp-gateway sunucunuz): POST { to, text, fileUrl, fileName }
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
